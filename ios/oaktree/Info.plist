<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Existing keys remain the same until the end of the file -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Oaktree</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    
    <!-- Add Associated Domains capability for password autofill -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <!-- Replace 'yourapp.com' with your actual domain -->
        <string>applinks:yourapp.com</string>
        <string>webcredentials:yourapp.com</string>
        <string>activitycontinuation:yourapp.com</string>
    </array>
    
    <!-- Add password autofill settings -->
    <key>com.apple.developer.authentication-services.autofill-credential-provider</key>
    <array>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER).CredentialProviderExtension</string>
    </array>
    
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    
    <!-- Existing permissions and other keys remain the same -->
    <key>NSCameraUsageDescription</key>
    <string>Oaktree requires camera access to take photos for document uploads and for video calls.</string>
    <key>NSDocumentDirectoryUsageDescription</key>
    <string>Oaktree requires access to save and manage your documents securely within the app.</string>
    <key>NSFileProtectionKey</key>
    <string>NSFileProtectionCompleteUntilFirstUserAuthentication</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string></string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Oaktree requires microphone access to record audio for communication purposes.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Oaktree requires permission to save edited or captured photos to your library.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Oaktree requires access to your photo library to select photos or documents for upload.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Allow Oaktree to access your documents.</string>
    
    <!-- Add contacts usage description for autofill -->
   <key>NSContactsUsageDescription</key>
<string>This app needs access to your contacts to help you connect with friends.</string>
<key>ITSAppUsesNonExemptEncryption</key>
<false/>
    
    <key>RCTNewArchEnabled</key>
    <true/>
    
    <!-- Rest of your existing configuration remains the same -->
    <key>UIAppFonts</key>
    <array>
        <string>AntDesign.ttf</string>
